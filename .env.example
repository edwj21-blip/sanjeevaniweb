SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Google Maps (hospital selection). Never commit the real key.
# Enable in Google Cloud: "Maps JavaScript API", "Places API (New)", "Geocoding API"; billing must be on.
# Restrict the key by HTTP referrer (e.g. http://localhost:8000/*) and to those three APIs.
GOOGLE_MAPS_API_KEY=

# Web Push (VAPID). Generate with:  python manage.py generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:you@example.com

# Run due reminders / re-activation while the site is being used (True/False)
RUN_JOBS_IN_REQUEST=True
